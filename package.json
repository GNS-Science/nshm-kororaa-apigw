{
  "name": "nshm-kororaa-api",
  "version": "0.2.0",
  "description": "A stitched graphql API for Kororaa UI.",
  "dependencies": {
    "@graphql-tools/delegate": "^12.3.1",
    "@graphql-tools/load": "^9.1.0",
    "@graphql-tools/schema": "^11.0.7",
    "@graphql-tools/stitch": "^10.4.1",
    "@graphql-tools/stitching-directives": "^4.1.3",
    "@graphql-tools/url-loader": "^10.0.7",
    "@graphql-tools/utils": "^13.2.0",
    "@graphql-tools/wrap": "^11.2.3",
    "@vendia/serverless-express": "^4.12.6",
    "@whatwg-node/fetch": "^0.12.1",
    "cross-fetch": "^4.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-yoga": "^6.0.1",
    "pino": "^10.4.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-tools/mock": "^10.1.2",
    "@serverless/eslint-config": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "get-graphql-schema": "^2.1.2",
    "git-list-updated": "^1.2.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "serverless": "^4.46.0",
    "serverless-offline": "^14.8.4",
    "serverless-plugin-warmup": "^8.4.1"
  },
  "main": "handler.mjs",
  "scripts": {
    "start": "node server.js",
    "test": "jest test",
    "deploy": "serverless deploy --stage ${STAGE}",
    "sls_doctor": "serverless doctor",
    "lint": "eslint  --ignore-pattern .gitignore .",
    "lint:updated": "pipe-git-updated --ext=js -- eslint --ignore-path .gitignore",
    "prettier-check": "prettier -c --ignore-path .gitignore \"**/*.{css,html,js,json,md,yaml,yml}\"",
    "prettier-check:updated": "pipe-git-updated --ext=css --ext=html --ext=js --ext=json --ext=md --ext=yaml --ext=yml -- prettier -c",
    "prettify": "prettier --write --ignore-path .gitignore \"**/*.{css,html,js,json,md,yaml,yml}\"",
    "prettify:updated": "pipe-git-updated --ext=css --ext=html --ext=js --ext=json --ext=md --ext=yaml --ext=yml -- prettier --write"
  },
  "author": "",
  "license": "AGPL3",
  "eslintConfig": {
    "extends": [
      "@serverless/eslint-config/node"
    ],
    "root": true,
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "packageManager": "yarn@4.11.0",
  "resolutions": {
    "@ungap/structured-clone": "1.4.0",
    "baseline-browser-mapping": "2.11.34",
    "browserslist": "4.29.5",
    "ip-address": "10.7.5",
    "@babel/core": "7.29.7",
    "path-to-regexp": "8.4.2",
    "js-yaml": "3.15.2",
    "brace-expansion@npm:^2.0.1": "2.1.7"
  }
}
